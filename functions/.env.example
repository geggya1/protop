# Microsoft Outlook calendar (SPA + PKCE). Secret optional.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Hospitality channel OAuth (Partner API — server-side secrets)
AIRBNB_CLIENT_ID=
AIRBNB_CLIENT_SECRET=
BOOKING_CLIENT_ID=
BOOKING_CLIENT_SECRET=

# Web Push — never commit the private key
VAPID_PRIVATE_KEY=
WEEKPLAN_VAPID_PRIVATE_KEY=

# Strava webhook — use a long random token (required; no insecure default)
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_CALLBACK_URL=

# Gemini (prefer runtime env / CI secret — not client)
GEMINI_API_KEY=

# Mail / SMS (Brevo xkeysib-…, Resend re_…, or SendGrid SG.…).
# Same value as Firebase Secret Manager MAIL_API_KEY (sendEmailVerificationV2).
# Friend invite callables read WEEKPLAN_MAIL_KEY (not MAIL_API_KEY) so deploy
# does not collide with the existing Cloud Run secret mount.
# Verification still uses defineSecret('MAIL_API_KEY').
WEEKPLAN_MAIL_KEY=
WEEKPLAN_GEMINI_KEY=
