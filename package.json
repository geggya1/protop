{
  "name": "protop",
  "version": "2.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "clean": "node -e \"const fs=require('fs'); for (const d of ['dist','web-build','.expo']) { try { fs.rmSync(d,{recursive:true,force:true}); } catch {} }\"",
    "export:web": "cross-env EXPO_NO_STATIC_RENDERING=1 expo export --platform web --output-dir dist",
    "export:web:clean": "npm run clean && npm run export:web",
    "check:imports": "node scripts/check-firebase-imports.mjs",
    "verify:dist": "node scripts/verify-web-dist.mjs",
    "stamp:web": "node scripts/stamp-build.js",
    "bump:major": "node scripts/bump-app-version.js --major",
    "verify:updates": "node scripts/verify-app-updates.mjs",
    "export:modultekster": "node src/modules/export-modultekster.mjs",
    "merge:marketing": "node scripts/merge-marketing.js",
    "generate:icons": "node scripts/generate-app-icons.js",
    "sync:logo": "node scripts/sync-brand-logo.js",
    "deploy": "npx firebase deploy --only hosting --project protop-c189c",
    "publish:web": "npm run build:web && npm run verify:dist && npm run deploy",
    "build:web": "npm run clean && npm run export:web && npm run stamp:web",
    "doctor": "npx expo-doctor",
    "prebuild:native": "npx expo prebuild --clean",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "build:native": "eas build --platform all --profile production",
    "build:preview": "eas build --platform all --profile preview",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "submit:native": "eas submit --platform all --profile production",
    "generate:responsive-images": "node scripts/generate-responsive-images.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/native": "^7.1.11",
    "@react-navigation/native-stack": "^7.3.16",
    "@zxing/browser": "^0.2.1",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.9",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-screen-orientation": "~9.0.9",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.11",
    "firebase": "^11.9.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-easy-crop": "^5.4.2",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-uuid": "^2.0.4",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.10",
    "cross-env": "^7.0.3",
    "firebase-tools": "^15.27.0",
    "sharp": "^0.35.4",
    "to-ico": "^1.1.5",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "expo-font": "~14.0.9"
  }
}
